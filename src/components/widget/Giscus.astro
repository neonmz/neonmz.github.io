---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";
import github_css from "@/styles/github.css?url"
import { absoluteUrl } from "@/utils/url-utils";


const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

const isCollapsed = "".length >= COLLAPSE_THRESHOLD;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
const github_theme_url = "fro" // import.meta.env.PROD ? absoluteUrl(github_css): "fro"
---

<WidgetLayout name={i18n(I18nKey.comments)} i18nKey={I18nKey.comments} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    <div class="giscus"></div>
    <script src="https://giscus.app/client.js"
            data-repo="neonmz/neonmz.github.io"
            data-repo-id="R_kgDOVTJWfA"
            data-category="Announcements"
            data-category-id="DIC_kwDOVTJWfM4DJkGk"
            data-mapping="pathname"
            data-strict="1"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme={github_theme_url}
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
    </script>
</WidgetLayout>
