---
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getCategoryList } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";
import { absoluteUrl } from "@/utils/url-utils";


const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

const isCollapsed = "".length >= COLLAPSE_THRESHOLD;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
// const github_theme_url = "fro" // import.meta.env.PROD ? absoluteUrl("/styles/github.css"): "fro"
---
<div class="card-base">
    <Markdown class="mb-6 markdown-content onload-animation">
        <WidgetLayout name={i18n(I18nKey.comments)} i18nKey={I18nKey.comments} id="comments" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}>
            <div id="tcomment"></div>
            <style is:inline> .tk-avatar-img {margin: 0 !important;} </style>
            <script src="/scripts/twikoo/twikoo.min.js" type="module"></script>
        </WidgetLayout>
    </Markdown>
</div>