---

import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getAboutMultiLanguage } from "@utils/content-utils";

const aboutEntries = await getAboutMultiLanguage();
const aboutEntriesLanguages = aboutEntries[0].data.languages;

import { siteConfig } from "../config";

const siteLanguage = (siteConfig.lang ?? "en").toLowerCase();

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
    <script define:vars={{ aboutEntriesLanguages, siteLanguage }}>
    (function () {
        window.pageInfo = {
            path: location.pathname,
            languages: aboutEntriesLanguages,
            siteLanguage: siteLanguage,
        };
        // try {
        //     var lang = localStorage?.getItem('language').toLowerCase() ?? siteLanguage;
        // } catch (e) { lang = siteLanguage; }
